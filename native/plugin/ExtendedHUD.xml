<?xml version="1.0" encoding="utf-8"?>
<!-- Layout copied from the packaged HudTest.xml (property 20/21 = x/y, 9/10 = width/height).
     src/extended_hud.cpp answers actions 21, 22, 25, 26, 31-35 and 41-43 and writes models 50-52 and 54-59 (58/59: the App information page).
     Main page: status + three submenus, Sport Bar (state 184), Speed Camera Warning (185), App information (103); a page with
     fixed row positions does not scroll, so 7 rows did not fit (car run 8). The Shift point
     and Warning distance pages copy ShiftDeck's shift-light page (installed on the car): a label with the current value and
     one button per value. Ids 23, 53 and 153 were Navigation (now on the feature/nav branch): never reuse them. -->
<pluginApps>
  <pluginApp applicationType="VehicleInformation" applicationWeight="212" text="ExtendedHUD">
    <entryButton id="1" action="10">
      <properties><property id="23" value="2" /></properties>
    </entryButton>
    <actions>
      <hmiAction id="10" target="100" />
      <raAction id="21" />
      <raAction id="22" />
      <hmiAction id="24" target="101" />
      <raAction id="25" />
      <raAction id="26" />
      <hmiAction id="27" target="102" />
      <hmiAction id="28" target="103" />
      <hmiAction id="182" target="184" />
      <hmiAction id="183" target="185" />
      <raAction id="31" />
      <raAction id="32" />
      <raAction id="33" />
      <raAction id="34" />
      <raAction id="35" />
      <raAction id="41" />
      <raAction id="42" />
      <raAction id="43" />
    </actions>
    <models>
      <raDataModel id="50" modelType="Richtext" />
      <raBoolModel id="51" />
      <raBoolModel id="52" />
      <raDataModel id="54" modelType="Richtext" />
      <raBoolModel id="55" />
      <raBoolModel id="56" />
      <raDataModel id="57" modelType="Richtext" />
      <raDataModel id="58" modelType="Richtext" />
      <raDataModel id="59" modelType="Richtext" />
    </models>
    <hmiStates>
      <hmiState id="100" text="ExtendedHUD">
        <components>
          <label id="150" model="50">
            <properties>
              <property id="20" value="46" /><property id="21" value="60" />
              <property id="9" value="900" /><property id="10" value="56" />
            </properties>
          </label>
          <button id="186" action="182" text="Sport Bar">
            <properties>
              <property id="20" value="46" /><property id="21" value="125" />
              <property id="9" value="560" /><property id="10" value="56" />
            </properties>
          </button>
          <button id="187" action="183" text="Speed Camera Warning">
            <properties>
              <property id="20" value="46" /><property id="21" value="183" />
              <property id="9" value="560" /><property id="10" value="56" />
            </properties>
          </button>
          <button id="158" action="28" text="App information">
            <properties>
              <property id="20" value="46" /><property id="21" value="241" />
              <property id="9" value="460" /><property id="10" value="56" />
            </properties>
          </button>
        </components>
      </hmiState>
      <hmiState id="184" parentId="100" text="Sport Bar">
        <components>
          <checkbox id="151" action="21" model="51" text="Show Sport Bar">
            <properties>
              <property id="20" value="46" /><property id="21" value="60" />
              <property id="9" value="460" /><property id="10" value="56" />
            </properties>
          </checkbox>
          <checkbox id="152" action="22" model="52" text="Always show Sport Bar">
            <properties>
              <property id="20" value="96" /><property id="21" value="118" />
              <property id="9" value="560" /><property id="10" value="56" />
            </properties>
          </checkbox>
          <button id="154" action="24" text="Shift point">
            <properties>
              <property id="20" value="96" /><property id="21" value="176" />
              <property id="9" value="460" /><property id="10" value="56" />
            </properties>
          </button>
        </components>
      </hmiState>
      <hmiState id="185" parentId="100" text="Speed Camera Warning">
