          <label id="181" model="59">
            <properties>
              <property id="20" value="46" /><property id="21" value="118" />
              <property id="9" value="900" /><property id="10" value="56" />
            </properties>
          </label>
        </components>
      </hmiState>
    </hmiStates>
  </pluginApp>
</pluginApps>
