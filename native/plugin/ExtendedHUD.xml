<?xml version="1.0" encoding="utf-8"?>
<!-- Layout copied from the packaged HudTest.xml (property 20/21 = x/y, 9/10 = width/height).
     src/extended_hud.cpp answers actions 21-23 and 31-35 and writes models 50-54. The Shift point page copies ShiftDeck's
     shift-light page (installed on the car): a label with the current value and one button per value. -->
<pluginApps>
  <pluginApp applicationType="VehicleInformation" applicationWeight="212" text="ExtendedHUD">
    <entryButton id="1" action="10">
      <properties><property id="23" value="2" /></properties>
    </entryButton>
    <actions>
      <hmiAction id="10" target="100" />
      <raAction id="21" />
      <raAction id="22" />
      <raAction id="23" />
      <hmiAction id="24" target="101" />
      <raAction id="31" />
      <raAction id="32" />
      <raAction id="33" />
      <raAction id="34" />
      <raAction id="35" />
    </actions>
    <models>
      <raDataModel id="50" modelType="Richtext" />
      <raBoolModel id="51" />
      <raBoolModel id="52" />
      <raBoolModel id="53" />
      <raDataModel id="54" modelType="Richtext" />
    </models>
    <hmiStates>
      <hmiState id="100" text="ExtendedHUD">
        <components>
          <label id="150" model="50">
            <properties>
              <property id="20" value="46" /><property id="21" value="70" />
              <property id="9" value="900" /><property id="10" value="60" />
            </properties>
          </label>
          <checkbox id="151" action="21" model="51" text="Sport Bar">
            <properties>
              <property id="20" value="46" /><property id="21" value="140" />
              <property id="9" value="460" /><property id="10" value="60" />
            </properties>
          </checkbox>
          <checkbox id="152" action="22" model="52" text="Always show Sport Bar">
            <properties>
              <property id="20" value="96" /><property id="21" value="205" />
              <property id="9" value="560" /><property id="10" value="60" />
            </properties>
          </checkbox>
          <checkbox id="153" action="23" model="53" text="Navigation">
            <properties>
              <property id="20" value="46" /><property id="21" value="270" />
              <property id="9" value="460" /><property id="10" value="60" />
            </properties>
          </checkbox>
          <button id="154" action="24" text="Shift point">
            <properties>
              <property id="20" value="46" /><property id="21" value="335" />
              <property id="9" value="460" /><property id="10" value="60" />
            </properties>
          </button>
        </components>
      </hmiState>
      <hmiState id="101" parentId="100" text="Shift point">
        <components>
          <label id="160" model="54" />
          <button id="161" action="31" text="6,200 RPM" />
          <button id="162" action="32" text="6,300 RPM" />
          <button id="163" action="33" text="6,400 RPM" />
          <button id="164" action="34" text="6,500 RPM" />
          <button id="165" action="35" text="6,600 RPM" />
        </components>
      </hmiState>
    </hmiStates>
  </pluginApp>
</pluginApps>
